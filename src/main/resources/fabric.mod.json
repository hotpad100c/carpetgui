{
  "schemaVersion": 1,
  "id": "carpetgui",
  "version": "${version}",
  "name": "${name}",
  "description": "Cool gui for carpet mod",
  "authors": [
    "Ryan100C"
  ],
  "contact": {
    "homepage": "https://github.com/hotpad100c/carpetgui",
    "sources": "https://github.com/hotpad100c/carpetgui"
  },
  "license": "MIT",
  "icon": "assets/carpetgui/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ml.mypals.carpetgui.CarpetGUI"
    ],
    "client": [
      "ml.mypals.carpetgui.CarpetGUIClient"
    ]
  },
  "mixins": [
    "carpetgui.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft}",
    "carpet": "*",
    "java": ">=${java_version}"
  },
  "accessWidener" : "accesswideners/${aw_file}",
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/components/AbstractWidget": [
        "ml/mypals/carpetgui/ui/inject/UIComponentStub"
      ],
      "net/minecraft/client/gui/components/EditBox": [
        "ml/mypals/carpetgui/ui/inject/GreedyInputUIComponent"
      ]
    }
  }
}